<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="700"
             xmlns:vm="using:Jojk.ViewModels"
             Background="Transparent"
             x:Class="Jojk.Views.SongsView"
             x:DataType="vm:SongsViewModel">

    <Border Background="{DynamicResource Widget}" CornerRadius="12" Margin="6">
        <Grid RowDefinitions="Auto,*,Auto" Margin="10">

            <TextBox Grid.Row="0" Classes="search" Margin="2,2,2,8"
                     Watermark="Search" Text="{Binding SearchTerm}"
                     Foreground="{DynamicResource Foreground}"/>

            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding FilteredSongs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SongItemViewModel">
                            <Border Classes="row" Classes.current="{Binding IsCurrent}"
                                    Padding="6,4" Margin="0,1">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="44" Height="44"
                                            CornerRadius="6" Background="{DynamicResource Surface2}"
                                            ClipToBounds="True">
                                        <Panel>
                                            <PathIcon Width="18" Height="18" Opacity="0.55"
                                                                      Foreground="{DynamicResource Foreground}"
                                                                      Data="{Binding AlbumIcon}"/>
                                            <Image Classes="albumart" Source="{Binding Art}" Stretch="UniformToFill"/>
                                        </Panel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{DynamicResource Foreground}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ArtistAndAlbum}" FontSize="12" Opacity="0.6"
                                                   Foreground="{DynamicResource Foreground}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Classes="rowplay"
                                            Command="{Binding $parent[ItemsControl].((vm:SongsViewModel)DataContext).TogglePlayCommand}"
                                            CommandParameter="{Binding}">
                                        <PathIcon Width="14" Height="14"
                                                  Foreground="{DynamicResource Foreground}"
                                                  Data="{Binding PlayIcon}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource Surface2}" CornerRadius="10"
                    Padding="12,10" Margin="0,8,0,0" IsVisible="{Binding Player.HasSelection}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">

                    <Button Grid.Row="0" Grid.Column="0" Classes="nowplaying" Command="{Binding OpenPlaybackCommand}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="52" Height="52"
                                    CornerRadius="8" Background="{DynamicResource Widget}" ClipToBounds="True">
                                <Panel>
                                    <PathIcon Width="20" Height="20" Opacity="0.5"
                                              Foreground="{DynamicResource Foreground}"
                                              Data="M12.9609 11.0398L18.4309 9.5498"/>
                                    <Image Classes="albumart" Source="{Binding Player.Art}" Stretch="UniformToFill"/>
                                </Panel>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Player.SongName}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource Foreground}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Player.ArtistAndAlbum}" FontSize="12" Opacity="0.6"
                                           Foreground="{DynamicResource Foreground}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Spacing="4">
                        <Button Classes="transport" Command="{Binding Player.PreviousCommand}">
                            <PathIcon Width="16" Height="16" Foreground="{DynamicResource Foreground}"
                                      Data="{Binding Player.PrevIcon}"/>
                        </Button>
                        <Button Classes="playpause" Command="{Binding Player.ToggleCurrentCommand}">
                            <PathIcon Width="20" Height="20" Foreground="{DynamicResource Widget}"
                                      Data="{Binding Player.PlayPauseIcon}"/>
                        </Button>
                        <Button Classes="transport" Command="{Binding Player.NextCommand}">
                            <PathIcon Width="16" Height="16" Foreground="{DynamicResource Foreground}"
                                      Data="{Binding Player.NextIcon}"/>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                        <TextBlock Grid.Column="0" Text="{Binding Player.TimeText}" FontSize="11" Opacity="0.6"
                                VerticalAlignment="Center" Foreground="{DynamicResource Foreground}"/>
                        <Slider Grid.Column="1" Classes="progress" Margin="8,0"
                                Minimum="0" Maximum="1" Value="{Binding Player.Position}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" FontSize="11" Opacity="0.6"
                                VerticalAlignment="Center" Foreground="{DynamicResource Foreground}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

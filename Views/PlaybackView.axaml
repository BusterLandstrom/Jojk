<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="700"
             xmlns:vm="using:Jojk.ViewModels"
             Background="Transparent"
             x:Class="Jojk.Views.PlaybackView"
             x:DataType="vm:PlaybackViewModel">

    <Border Background="{DynamicResource Widget}" CornerRadius="12" Margin="6">
        <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                <Button Grid.Column="0" Classes="iconback" Command="{Binding BackCommand}">
                    <Path Stroke="{DynamicResource Foreground}" StrokeThickness="2"
                            Width="14" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Stretch="Uniform" StrokeLineCap="Round" StrokeJoin="Round" Data="{Binding Player.DownIcon}"/>
                </Button>
                <TextBlock Grid.Column="1" Text="Now Playing" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Opacity="0.6" Foreground="{DynamicResource Foreground}"/>
                <Border Grid.Column="2" Width="40"/>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="24">
                <Border Width="280" Height="280" CornerRadius="14"
                        Background="{DynamicResource Surface2}" ClipToBounds="True"
                        HorizontalAlignment="Center">
                    <Panel>
                        <PathIcon Width="64" Height="64" Opacity="0.45"
                                  Foreground="{DynamicResource Foreground}"
                                  Data="{Binding Player.AlbumIcon}"/>
                        <Image Classes="albumart" Source="{Binding Player.Art}" Stretch="UniformToFill"/>
                    </Panel>
                </Border>

                <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding Player.SongName}" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource Foreground}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Player.ArtistAndAlbum}" FontSize="14" Opacity="0.6"
                               Foreground="{DynamicResource Foreground}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="4,16,4,8">
                <TextBlock Grid.Column="0" Text="{Binding Player.TimeText}" FontSize="11" Opacity="0.6"
                           VerticalAlignment="Center" Foreground="{DynamicResource Foreground}"/>
                <Slider Grid.Column="1" Classes="progress" Margin="10,0"
                           Minimum="0" Maximum="1" Value="{Binding Player.Position}"/>
                <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" FontSize="11" Opacity="0.6"
                           VerticalAlignment="Center" Foreground="{DynamicResource Foreground}"/>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Spacing="22" Margin="0,4,0,8">
                <Button Classes="transport" Command="{Binding Player.PreviousCommand}">
                    <PathIcon Width="22" Height="22" Foreground="{DynamicResource Foreground}"
                              Data="{Binding Player.PrevIcon}"/>
                </Button>
                <Button Classes="playbig" Command="{Binding Player.ToggleCurrentCommand}">
                    <PathIcon Width="26" Height="26" Foreground="{DynamicResource Widget}"
                              Data="{Binding Player.PlayPauseIcon}"/>
                </Button>
                <Button Classes="transport" Command="{Binding Player.NextCommand}">
                    <PathIcon Width="22" Height="22" Foreground="{DynamicResource Foreground}"
                              Data="{Binding Player.NextIcon}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
